# ---------- 1. Required Settings ----------
PORT=3710

# A long random password for security (auto-generated by setup.js)
ARC_TOKEN=

# YOUR mobile number with country code (e.g. 919876543210)
OWNER_NUMBER=

# Keep true for testing; set to false once your setup is complete
ALLOW_NO_CALLER=true


# ---------- 2. 100% Free AI Intelligence (Optional) ----------
# Arc works completely offline out-of-the-box with its built-in smart intent matcher.
# For advanced LLM conversation and reasoning without paying anything:

# Free Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OR Free Groq API Key (Get free key at: https://console.groq.com/)
GROQ_API_KEY=


# ---------- 3. Optional: Paid Telephony (Sarvam AI) ----------
# Only needed if you want traditional cellular phone calls instead of the free Web Voice Call.
ARC_PHONE=
SARVAM_WORKSPACE_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
ARC_APP_ID=
ARC_APP_VERSION=
ARC_AGENT_NUMBER=
ARC_CONNECTION_ID=

# ---------- 4. Optional: Google Classroom Uploads ----------
# Empty = off. attach = upload file without turning in. live = upload and turn in.
CLASSROOM_SUBMIT=
